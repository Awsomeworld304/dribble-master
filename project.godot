; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dribble Master"
config/version="0.0.0.1"
run/main_scene="uid://busys06oo6ski"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Leaderboard="*res://Autoloads/leaderboard.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/per_pixel_transparency/allowed=true

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/github_to_itch/plugin.cfg")

[github_to_itch]

config/itch_username="jamestech4849"
config/itch_project_name="dribble-master"

[gui]

theme/default_font_subpixel_positioning=0
theme/lcd_subpixel_layout=0

[input]

Kick={
"deadzone": 0.2,
